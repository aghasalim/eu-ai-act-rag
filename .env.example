# Copy to .env and fill in. Only the API key is required.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Provider is swappable without code changes -- all four speak the
# OpenAI-compatible chat API.
#   groq     (default, free tier)
#   openai   -> OPENAI_API_KEY
#   gemini   -> GEMINI_API_KEY
#   ollama   -> no key; set OLLAMA_HOST if not localhost:11434
#   extractive -> no generation, retrieval-only
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Retrieval
RETRIEVAL_MODE=hybrid
TOP_K=6
EMBED_MODEL=BAAI/bge-small-en-v1.5
